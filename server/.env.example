# MQTT broker (the server connects locally, not through the tunnel)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Leave both blank to connect without credentials
MQTT_USER=
MQTT_PASS=

# Detection of stream-mode frames (python -m master.cli start <mac>)
MODEL_PATH=yolo11n.pt
# cpu or cuda:0
DEVICE=cpu
# A streamed frame is "pedestrian" when YOLO's best person score is >= this.
# Alerts are decided on each device: change its threshold, dwell, gap and cooldown with
#   python -m master.cli config <mac> threshold=0.6 dwell_s=5 max_gap_s=3 cooldown_s=30
PEDESTRIAN_CONF_THRESHOLD=0.6

# Alert log (SQLite) and snapshots
EVENTS_DIR=./events

# Dashboard (python -m master.web)
# Inferences kept per device (thumbnails + rows)
INFERENCE_HISTORY=200
# 0.0.0.0 = reachable from the LAN; 127.0.0.1 = this PC only
WEB_HOST=0.0.0.0
WEB_PORT=8000
