# Server settings. With Docker Compose, compose.yaml reads this file next to it and
# passes these values to the containers. Without Docker (python -m master.app on a PC),
# master/settings.py reads it directly.

# MQTT broker, as the master sees it. The master never goes through the tunnel.
#   Docker Compose: the broker service name, "mosquitto"
#   Without Docker: the broker PC, e.g. 127.0.0.1 or a LAN IP
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Server account (master service and CLI). Required with Docker Compose, where
# Mosquitto rejects anonymous clients. Generate passwords with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MQTT_USER=server
MQTT_PASS=
# Device accounts, Docker Compose only: space-separated <device-id>:<password> pairs.
# The device id is the one the firmware logs as "running as <id>" (its MAC). Each
# device may only use its own topics. Put the same id and password in the device's
# menuconfig as MQTT username and MQTT password.
DEVICE_CREDENTIALS=

# Detection of stream-mode frames (python -m master.cli start <mac>)
# cpu or cuda:0 (the Docker image is CPU-only)
DEVICE=cpu
# A streamed frame is "pedestrian" when YOLO's best person score is >= this.
# Alerts are decided on each device: change its threshold, dwell, gap and cooldown with
#   python -m master.cli config <mac> threshold=0.6 dwell_s=5 max_gap_s=3 cooldown_s=30
PEDESTRIAN_CONF_THRESHOLD=0.6

# Host verification of device alert candidates. The device sends an event for
# every positive frame (its own low threshold); the host re-runs its model on
# the snapshot and commands the alert only when the verified run spans
# PEDESTRIAN_VERIFY_DWELL_S without a gap over PEDESTRIAN_VERIFY_MAX_GAP_S.
#   PEDESTRIAN_VERIFY_THRESHOLD        host model confirm cutoff
#   PEDESTRIAN_VERIFY_ALERT_COOLDOWN_S min time between host alert commands
PEDESTRIAN_VERIFY_THRESHOLD=0.8
PEDESTRIAN_VERIFY_DWELL_S=5.0
PEDESTRIAN_VERIFY_MAX_GAP_S=3.0
PEDESTRIAN_VERIFY_ALERT_COOLDOWN_S=5.0

# Dashboard: inferences kept per device (thumbnails + rows)
INFERENCE_HISTORY=200

# Without Docker only. The Docker image sets the model and events paths itself,
# and the dashboard always listens on 0.0.0.0:8000 inside its container.
# MODEL_PATH=yolo11n.pt
# EVENTS_DIR=./events
# WEB_HOST=0.0.0.0
# WEB_PORT=8000

# Optional image archive (docker compose -f compose.yaml -f compose.dataset.yaml):
# host folder that receives every image, for pushing to CVAT
# DATASET_HOST_DIR=D:/dataset
# Without Docker: DATASET_DIR=./dataset
